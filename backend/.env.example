# Copy to `.env` for local development. Every variable is validated at startup
# by app/core/config.py — invalid values crash the process with a clear error.

DISPATCH_ENVIRONMENT=development
DISPATCH_DEBUG=true

DISPATCH_DATABASE_URL=postgresql+asyncpg://dispatch:dispatch@localhost:5432/dispatch
DISPATCH_REDIS_URL=redis://localhost:6379/0

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DISPATCH_SECRET_KEY=insecure-dev-secret-change-me

DISPATCH_CORS_ORIGINS=["http://localhost:3000"]
DISPATCH_LOG_LEVEL=INFO

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Required for the Gmail connect flow; leave unset in
# environments that don't need Gmail sending.
DISPATCH_GOOGLE_OAUTH_CLIENT_ID=
DISPATCH_GOOGLE_OAUTH_CLIENT_SECRET=
DISPATCH_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/gmail/callback

# Where the browser is sent back to after completing (or failing) the Gmail
# OAuth flow — the frontend app's own origin, not this API's.
DISPATCH_FRONTEND_BASE_URL=http://localhost:3000
